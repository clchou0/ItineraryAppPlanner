<Window x:Class="Planner.WPF.myItineraries"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Planner.WPF"
        mc:Ignorable="d"
        Title="myItineraries" Height="450" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="LightYellow">
            <Button x:Name="CloseButton"
            Content="X Close"
            Width="70" Height="40"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="15,0,0,0"
            Background="Transparent" BorderThickness="0"
            Click="CloseButton_Click"/>

            <TextBlock Text="My Itineraries" Foreground="DarkGray"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="20" FontWeight="Bold"/>
        </Grid>

        <!-- Main Content Area (Row 1) -->
        <Grid Grid.Row="1">

            <!-- 1. Itinerary List View -->
            <Grid x:Name="ItineraryListView">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="itineraryList" ItemsSource="{Binding Itineraries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding CityName}" FontSize="16" FontWeight="Bold"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ArriveDate, StringFormat={}{0:dd MMM yyyy} -  }"/>
                                                    <TextBlock Text="{Binding LeaveDate, StringFormat={}{0:dd MMM yyyy}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="View Details" Width="150" Height="40" Margin="5,0,0,0" Tag="{Binding Id}" Click="ViewDetails_Click"/>
                                                <Button Content="Delete" Width="90" Height="40" Margin="5,0,0,0" Tag="{Binding Id}" Click="DeleteItinerary_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

        <!-- 2. Itinerary Details View -->
        <Grid x:Name="ItineraryDetailsView" Visibility="Collapsed" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="BackButton" 
                Grid.Row="0"
                Content="Back"
                Height="29" Width="205"
                HorizontalAlignment="Left"
                Margin="0,20,0,20"
                Background="#FFFEFFF7" 
                BorderThickness="0" 
                Click="BackButton_Click"/>

            <StackPanel Grid.Row="1" Margin="0,20,0,20">
                <TextBlock x:Name="txtDetailTitle" Text="My Itinerary" FontWeight="Bold"/>
                <TextBlock x:Name="txtDetailDates" Foreground="Gray" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                <StackPanel>
                    <ItemsControl x:Name="detailBlocks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">

                                    <StackPanel>
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:dd MMM yyyy HH:mm}}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Cost, StringFormat=Entry Cost: ${0:F2}}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="txtTotalCost" Text="Total Entry Cost: $0.00" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Button Content="Move to Builder" Width="150" Height="40" Click="MoveButton_Click"/>
                        <Button Content="Export PDF" Width="150" Height="40" Margin="5" Click="ExportButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
